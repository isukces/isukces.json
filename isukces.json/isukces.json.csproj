<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>iSukces.Json</AssemblyName>
    <Product>iSukces.Json</Product>
    <ProjectGuid>{9FE56FFA-B4E0-4463-BCAE-739D352DD5F3}</ProjectGuid>
    <TargetFrameworks>net6.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>iSukces.Json</RootNamespace>
    <AssemblyVersion>1.25.1203.23</AssemblyVersion>
    <FileVersion>1.25.1203.23</FileVersion>
    <Version>1.25.1203.23</Version>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <SignAssembly>true</SignAssembly>
