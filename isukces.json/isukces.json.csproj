    <PackageProjectUrl>https://github.com/isukces/isukces.json</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryUrl>https://github.com/isukces/isukces.json</RepositoryUrl>
